    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "@univerjs/sheets": "1.2.0",
    "@univerjs/ui": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
