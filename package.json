{
  "name": "univer",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@9.4.0",
  "description": "Open, edit and create Univer spreadsheets (.usheet) directly inside Obsidian.",
  "author": "DreamNum",
  "license": "Apache-2.0",
  "keywords": [
    "univer",
    "spreadsheet",
    "excel",
    "usheet",
    "obsidian"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@univerjs/core": "1.2.0",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/presets": "1.2.0",
    "@univerjs/sheets": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "obsidian": "1.14.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
